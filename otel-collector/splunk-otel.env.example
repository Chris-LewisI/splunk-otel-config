# Environment for the host/VM collector configs in this directory.
# Copy to /etc/otel/collector/splunk-otel-collector.conf (Linux deb/rpm install)
# or export before launching otelcol. Do not commit a filled-in copy.
#
# agent_config.yaml and gateway_config.yaml resolve every endpoint and token from
# these variables - neither file contains a hardcoded URL or credential.

# ---- Required by both agent_config.yaml and gateway_config.yaml ----

# Splunk Observability org access token.
SPLUNK_ACCESS_TOKEN=CHANGEME

# Realm, e.g. us0, us1, eu0. gateway_config.yaml builds its ingest/api URLs from this.
SPLUNK_REALM=CHANGEME

# Interface the receivers bind to. 127.0.0.1 keeps the agent local-only, which is
# the packaged default. A gateway must bind an interface its agents can reach.
SPLUNK_LISTEN_INTERFACE=127.0.0.1

# Hard memory ceiling for the memory_limiter processor, in MiB.
# Rule of thumb: ~90% of the memory allocated to the collector process.
SPLUNK_MEMORY_LIMIT_MIB=512

SPLUNK_COLLECTOR_LOG_LEVEL=info

# ---- Required by agent_config.yaml (explicit URLs rather than realm) ----

SPLUNK_API_URL=https://api.CHANGEME.signalfx.com
SPLUNK_INGEST_URL=https://ingest.CHANGEME.signalfx.com

# ---- Logs to Splunk Platform via HEC ----
# The HEC endpoint may be Splunk Cloud, an indexer, or a Heavy Forwarder with HEC
# enabled. Only required if the logs pipeline is in use.

SPLUNK_HEC_TOKEN=CHANGEME
SPLUNK_HEC_URL=https://http-inputs-CHANGEME.splunkcloud.com/services/collector

# ---- Agent forwarding to a gateway ----
# Only set when this agent sends to a gateway instead of Splunk directly. You must
# also uncomment the matching gateway blocks in agent_config.yaml.

# SPLUNK_GATEWAY_URL=otel-gateway.internal.example.com
